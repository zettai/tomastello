# Scaleway Object Storage Configuration
SCW_ACCESS_KEY=your-access-key-here
SCW_SECRET_KEY=your-secret-key-here
SCW_DEFAULT_REGION=nl-ams
SCALEWAY_BUCKET=your-bucket-name
SCALEWAY_ENDPOINT=https://s3.nl-ams.scw.cloud

# Public URL of the site (used as the server URL in the OpenAPI docs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Serve /swagger and /api/swagger in production too (off by default; see src/lib/apiDocs.ts)
ENABLE_API_DOCS=false

# Authentication (IMPORTANT: Change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-long-and-random
# Set to true only if using HTTPS, false for HTTP
USE_SECURE_COOKIES=false

# Node Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Registration Feature Flag
ALLOW_NEW_REGISTRATIONS=false

# Container Registry Credentials (for deploy.sh script)
REGISTRY_USERNAME=your-registry-username
REGISTRY_TOKEN=your-registry-token-here

# Logging
LOG_LEVEL=info
LOG_DIR=/app/logs

# Upload Rate Limiting
MAX_UPLOADS_PER_IP_HOUR=10
MAX_UPLOADS_PER_USER_HOUR=20
# 1 GB in bytes
MAX_SYSTEM_BYTES_24H=1073741824

# Email Notifications (Resend — leave blank to disable)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=admin@tomas-tello.stream
NOTIFY_EMAIL_FROM=noreply@tomas-tello.stream

# Uploads (see docs/UPLOADS.md)
# relay: files go through the API (works anywhere, no bucket CORS needed).
# presigned: the browser uploads straight to the bucket; needs the bucket CORS rules first.
UPLOAD_MODE=relay
# Multipart chunk size in MB (5-64), read at runtime and sent to the browser.
UPLOAD_CHUNK_SIZE_MB=5
